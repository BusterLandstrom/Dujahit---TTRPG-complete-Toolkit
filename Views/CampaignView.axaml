<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dujahit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             xmlns:views="clr-namespace:Dujahit.Views"
             xmlns:map="clr-namespace:Dujahit.Views.Map"
             xmlns:gv="clr-namespace:Dujahit.Models.Database"
             x:DataType="vm:CampaignViewModel"
             x:Class="Dujahit.Views.CampaignView" Background="Transparent">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:CharacterDashboardViewModel">
            <views:CharacterDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CharacterSheetViewModel">
            <views:CharacterSheetView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CharacterCreationViewModel">
            <views:CharacterCreationView/>
        </DataTemplate>
        <DataTemplate DataType="vm:MapHubViewModel">
            <map:MapHubView/>
        </DataTemplate>
        <DataTemplate DataType="vm:MapSessionViewModel">
            <map:MapSessionView/>
        </DataTemplate>
        <DataTemplate DataType="vm:NotesViewModel">
            <views:NotesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:MindmapViewModel">
            <views:MindmapView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CodexViewModel">
            <views:CodexView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DmScreenViewModel">
            <views:DmScreenView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:EncounterBuilderViewModel">
            <views:EncounterBuilderView/>
        </DataTemplate>
        <DataTemplate DataType="vm:EncounterRunnerViewModel">
            <views:EncounterRunnerView/>
        </DataTemplate>
        <DataTemplate DataType="vm:HandoutsViewModel">
            <views:HandoutsView/>
        </DataTemplate>

        <DataTemplate DataType="vm:QuickNotesPanelViewModel">
            <views:QuickNotesPanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SoundboardViewModel">
            <views:SoundboardWidgetView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SoundboardScreenViewModel">
            <views:SoundboardScreenView/>
        </DataTemplate>
        <DataTemplate DataType="vm:QuickNotesWidgetViewModel">
            <views:QuickNotesWidgetView/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="1*,3.5*">
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource BackdropBrush}" IsHitTestVisible="False"/>
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3.5*" />
            </Grid.ColumnDefinitions>

            <ContentControl Content="{Binding SideMenu}" Margin="0,16,-40,16" ZIndex="1"/>
            <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentContent}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.18"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    ClipToBounds="False"
                    Spacing="8">
            <Button Classes="accent"
                    Height="30"
                    Padding="14,0"
                    VerticalAlignment="Bottom"
                    IsVisible="{Binding ReturnToFightVisible}"
                    Command="{Binding ReturnToFightCommand}"
                    Content="{Binding LiveSession.ReturnLabel}"/>

            <ContentControl Content="{Binding Soundboard}"
                            Width="{Binding Soundboard.WidgetWidth}"
                            IsVisible="{Binding HasSoundboard}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"/>

            <ContentControl Content="{Binding QuickNotesWidget}"
                            Width="{Binding QuickNotesWidget.WidgetWidth}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Height="{Binding QuickNotesWidget.WidgetHeight}"/>

            <ContentControl Content="{Binding ChatWidget}"
                            Width="{Binding ChatWidget.WidgetWidth}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Height="{Binding ChatWidget.WidgetHeight}"/>
        </StackPanel>

        <Border Grid.ColumnSpan="2" IsVisible="{Binding NotificationVisible}"
                Background="{DynamicResource Widget}"
                BorderBrush="{DynamicResource AccentColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusStandard}"
                Padding="18,10"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                ZIndex="1000">
            <TextBlock Text="{Binding Notification}"
                       Foreground="{DynamicResource WidgetForeground}"/>
        </Border>

        <Border Grid.ColumnSpan="2" IsVisible="{Binding RollToastVisible}"
                Background="{DynamicResource Widget}"
                BorderBrush="{DynamicResource AccentColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusStandard}"
                Padding="16,10"
                Margin="0,56,0,0"
                MaxWidth="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                ZIndex="1000">
            <StackPanel Spacing="3">
                <TextBlock Text="Your roll" Classes="fieldLabel"/>
                <TextBlock Text="{Binding RollToast}"
                           Foreground="{DynamicResource WidgetForeground}"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.ColumnSpan="2" IsVisible="{Binding HandoutVisible}"
                Background="#CC000000"
                ZIndex="1001">
            <Border Background="{DynamicResource Widget}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="900"
                    MaxHeight="800">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding HandoutName}"
                                   Foreground="{DynamicResource WidgetForeground}"
                                   FontSize="{DynamicResource FontSizeHeader}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="close"
                                Command="{Binding DismissHandoutCommand}"
                                AutomationProperties.Name="Close" ToolTip.Tip="Close">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconClose}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <Image Source="{Binding ActiveHandoutImage}"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"/>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" IsVisible="{Binding OwedSaveVisible}"
                Background="#CC000000"
                ZIndex="1003">
            <Border Background="{DynamicResource Widget}"
                    BorderBrush="{DynamicResource AccentColor}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Padding="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="14">
                    <TextBlock Text="Saving throw"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="{DynamicResource FontSizeHeader}"/>
                    <TextBlock Text="{Binding OwedSaveLabel}"
                               Foreground="{DynamicResource WidgetForeground}"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                    <Button Classes="accent"
                            Content="Roll it"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding RollOwedSaveCommand}"
                            AutomationProperties.Name="Roll the saving throw you owe"/>
                    <Button Classes="ghost"
                            Content="Not now"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding DismissOwedSaveCommand}"
                            AutomationProperties.Name="Hide this, the save stays owed on your panel"
                            ToolTip.Tip="Hide this, the save stays owed on your panel"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" IsVisible="{Binding SearchOverlayVisible}"
                Background="#CC000000"
                ZIndex="1002">
            <Border Background="{DynamicResource Widget}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,110,0,0"
                    Width="640"
                    MaxHeight="560">
                <DockPanel DataContext="{Binding Search}">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBox AutomationProperties.Name="Search characters, notes, factions, maps, items, calendar, timeline..." x:Name="SearchBox"
                                 Grid.Column="0"
                                 FontSize="16"
                                 Text="{Binding Query}"
                                 Watermark="Search characters, notes, factions, maps, items, calendar, timeline..."/>
                        <Button Grid.Column="1"
                                Classes="close"
                                Margin="8,0,0,0"
                                Command="{Binding $parent[Border].((vm:CampaignViewModel)DataContext).DismissSearchCommand}"
                                AutomationProperties.Name="Close" ToolTip.Tip="Close">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconClose}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchResultRow">
                                        <Button AutomationProperties.Name="{Binding Title}" Classes="row"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,6"
                                                Command="{Binding $parent[ItemsControl].((vm:GlobalSearchViewModel)DataContext).ChooseCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="86,*">
                                                <Border Grid.Column="0"
                                                        Classes="sticky"
                                                        Padding="8,3"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           Classes="tileName"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Type to find any character, note, faction, map or item."
                                       Classes="muted"
                                       FontSize="13"
                                       Margin="2,8"
                                       IsVisible="{Binding ShowPrompt}"/>
                            <TextBlock Text="No matches."
                                       Classes="muted"
                                       FontSize="13"
                                       Margin="2,8"
                                       IsVisible="{Binding ShowEmptyHint}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>