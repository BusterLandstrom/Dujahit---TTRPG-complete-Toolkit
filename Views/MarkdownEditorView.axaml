<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gv="clr-namespace:Dujahit.Models.Database"
             xmlns:vm="using:Dujahit.ViewModels"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Dujahit.Views.MarkdownEditorView"
             x:DataType="vm:MarkdownEditorViewModel"
             Background="Transparent"
             FontFamily="{DynamicResource MainFont}"
             Foreground="{DynamicResource Foreground}">

    <UserControl.Styles>
        <Style Selector="Button.tb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>
        <Style Selector="Button.tb:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Widget}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.tb:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="Border.tbsep">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Button.refrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.refrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="Border.reftag">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.segwrap">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style Selector="RadioButton.seg">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="seg" Background="Transparent" CornerRadius="5" Padding="12,4">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg:pointerover /template/ Border#seg">
            <Setter Property="Background" Value="{DynamicResource Widget}"/>
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#seg">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="TextBox.mdsource">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Menlo, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                Background="{DynamicResource Widget}"
                CornerRadius="{DynamicResource CornerRadiusStandard}"
                Padding="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="2">

                    <Border Classes="segwrap" IsEnabled="{Binding !IsReadOnly}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton Classes="seg" GroupName="mdmode" AutomationProperties.Name="Write" IsChecked="{Binding IsEditing}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{x:Static gv:GlobalVariables.IconDraw}" Width="13" Height="13"/>
                                    <TextBlock Text="Write"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="seg" GroupName="mdmode" Content="Preview"
                                         IsChecked="{Binding IsViewing}"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="tbsep"/>

                    <StackPanel Orientation="Horizontal" Spacing="2" IsEnabled="{Binding IsEditing}">

                        <Button Classes="tb" Content="H1" AutomationProperties.Name="Heading 1" ToolTip.Tip="Heading 1"
                                Command="{Binding HeadingCommand}" CommandParameter="# "/>
                        <Button Classes="tb" Content="H2" AutomationProperties.Name="Heading 2" ToolTip.Tip="Heading 2"
                                Command="{Binding HeadingCommand}" CommandParameter="## "/>
                        <Button Classes="tb" Content="H3" AutomationProperties.Name="Heading 3" ToolTip.Tip="Heading 3"
                                Command="{Binding HeadingCommand}" CommandParameter="### "/>

                        <Border Classes="tbsep"/>

                        <Button Classes="tb" FontWeight="Bold" Content="B" AutomationProperties.Name="Bold" ToolTip.Tip="Bold"
                                Command="{Binding BoldCommand}"/>
                        <Button Classes="tb" FontStyle="Italic" Content="I" AutomationProperties.Name="Italic" ToolTip.Tip="Italic"
                                Command="{Binding ItalicCommand}"/>
                        <Button Classes="tb" Content="S̶" AutomationProperties.Name="Strikethrough" ToolTip.Tip="Strikethrough"
                                Command="{Binding StrikeCommand}"/>
                        <Button Classes="tb" Content="&lt;/&gt;" AutomationProperties.Name="Inline code" ToolTip.Tip="Inline code"
                                Command="{Binding InlineCodeCommand}"/>

                        <Border Classes="tbsep"/>

                        <Button Classes="tb" Content="•" AutomationProperties.Name="Bulleted list" ToolTip.Tip="Bulleted list (Ctrl+Shift+8)"
                                Command="{Binding BulletListCommand}"/>
                        <Button Classes="tb" Content="1." AutomationProperties.Name="Numbered list" ToolTip.Tip="Numbered list (Ctrl+Shift+7)"
                                Command="{Binding NumberedListCommand}"/>
                        <Button Classes="tb" AutomationProperties.Name="Task list" ToolTip.Tip="Task list (Ctrl+Shift+9)"
                                Command="{Binding TaskListCommand}">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconTaskList}" Width="15" Height="15"/>
                        </Button>
                        <Button Classes="tb" AutomationProperties.Name="Blockquote" ToolTip.Tip="Blockquote"
                                Command="{Binding QuoteCommand}">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconQuote}" Width="15" Height="15"/>
                        </Button>

                        <Border Classes="tbsep"/>

                        <Button Classes="tb" Content="{}{ }" AutomationProperties.Name="Code block" ToolTip.Tip="Code block"
                                Command="{Binding CodeBlockCommand}"/>
                        <Button Classes="tb" Content="Table" AutomationProperties.Name="Table" ToolTip.Tip="Insert a table"
                                Command="{Binding TableCommand}"/>
                        <Button Classes="tb" Content="―" AutomationProperties.Name="Horizontal rule" ToolTip.Tip="Horizontal rule"
                                Command="{Binding HorizontalRuleCommand}"/>
                        <Button Classes="tb" AutomationProperties.Name="Link" ToolTip.Tip="Link (Ctrl+K)"
                                Command="{Binding LinkCommand}">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconLink}" Width="15" Height="15"/>
                        </Button>
                        <Button Classes="tb" AutomationProperties.Name="Image" ToolTip.Tip="Image"
                                Command="{Binding ImageCommand}">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconImage}" Width="15" Height="15"/>
                        </Button>

                        <Border Classes="tbsep"/>

                        <ToggleButton Name="RefButton" Classes="tb" Content="@"
                                      FontWeight="Bold"
                                      AutomationProperties.Name="Insert reference"
                                      ToolTip.Tip="Link a character, npc, item, mindmap or note"
                                      IsChecked="{Binding RefPickerOpen}"/>
                        <Popup PlacementTarget="{Binding #RefButton}"
                               Placement="BottomEdgeAlignedLeft"
                               IsLightDismissEnabled="True"
                               IsOpen="{Binding RefPickerOpen}">
                            <Border Background="{DynamicResource Widget}"
                                    BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Width="330"
                                    Margin="0,4,0,0">
                                <StackPanel Spacing="6">
                                    <TextBox Name="RefSearchBox"
                                             Text="{Binding RefQuery}"
                                             Watermark="Search a character, npc, item, mindmap or note"/>
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RefResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SearchResultRow">
                                                    <Button Classes="refrow"
                                                            AutomationProperties.Name="{Binding Title}"
                                                            Command="{Binding $parent[ItemsControl].((vm:MarkdownEditorViewModel)DataContext).InsertReferenceCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Classes="reftag">
                                                                <TextBlock Text="{Binding Subtitle}" Classes="fieldLabel"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Classes="muted" FontSize="12"
                                               IsVisible="{Binding RefShowEmpty}"
                                               Text="Nothing matches that yet."/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Widget}"
                CornerRadius="{DynamicResource CornerRadiusStandard}"
                Padding="16,12"
                Margin="0,8,0,0">
            <Grid>
                <TextBox AutomationProperties.Name="Markdown source" Name="SourceBox"
                         Classes="mdsource"
                         IsVisible="{Binding IsEditing}"
                         Text="{Binding Markdown, Mode=TwoWay}"/>

                <md:MarkdownScrollViewer Name="MdViewer"
                         IsVisible="{Binding IsViewing}"
                         SelectionEnabled="False"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Classes="muted"
                   FontSize="11"
                   HorizontalAlignment="Right"
                   Margin="4,4,6,0"
                   IsVisible="{Binding IsEditing}"
                   Text="{Binding CountLabel}"/>
    </Grid>
</UserControl>
