<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Dujahit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:DataType="vms:UserInitViewModel"
             x:Class="Dujahit.Views.UserInitView"
             Background="{DynamicResource Background}"
             FontFamily="{DynamicResource MainFont}"
             Foreground="{DynamicResource Foreground}">

    <Grid>
        <Border Classes="card"
                Width="760"
                MaxHeight="620"
                Padding="40,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,Auto,*">

                <Grid.Styles>
                    <Style Selector="ListBox">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="14,10" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Background}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource Background}" />
                    </Style>
                </Grid.Styles>

                <TextBlock Grid.Row="0"
                           Classes="header"
                           Text="Create or log in"
                           FontSize="28"
                           HorizontalAlignment="Center" />

                <Border Grid.Row="1" Classes="divider" Margin="0,18" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,1.1*">

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="14" Margin="0,0,24,0">
                        <TextBlock Classes="muted" Text="New here?" />
                        <TextBox AutomationProperties.Name="Choose a username" Text="{Binding Username, Mode=TwoWay}"
                                 Watermark="Choose a username"
                                 Height="48"
                                 FontSize="18" />
                        <Button Classes="primary"
                                Content="Create user"
                                Command="{Binding SelectCreate}"
                                HorizontalAlignment="Stretch"
                                Padding="20,12" />
                    </StackPanel>

                    <Border Grid.Column="1" Classes="dividerV" Margin="0,4" />

                    <Grid Grid.Column="2" RowDefinitions="Auto,*" Margin="24,0,0,0">
                        <TextBlock Grid.Row="0"
                                   Classes="muted"
                                   Text="Returning? Pick your user"
                                   Margin="0,0,0,10" />
                        <ListBox AutomationProperties.Name="Returning? Pick your user" Grid.Row="1"
                                 ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource Foreground}" />
                                        <TextBlock Text="{Binding Id}"
                                                   FontSize="12"
                                                   Opacity="0.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Foreground}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
