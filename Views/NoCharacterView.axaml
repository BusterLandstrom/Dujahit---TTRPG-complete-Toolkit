<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dujahit.ViewModels"
             x:Class="Dujahit.Views.NoCharacterView"
             x:DataType="vm:NoCharacterViewModel"
             FontFamily="{DynamicResource MainFont}"
             Background="Transparent">
    <Border Background="{DynamicResource Widget}"
            CornerRadius="{DynamicResource CornerRadiusStandard}"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="10">
            <TextBlock Classes="header"
                       Name="HeaderText"
                       Text="No Character"
                       Cursor="Hand"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="body"
                       Text="{Binding Message}"
                       MaxWidth="320"
                       TextAlignment="Center" />
            <TextBlock Name="DoctorArt"
                       IsVisible="False"
                       FontFamily="Consolas,Courier New,monospace"
                       FontSize="4"
                       LineHeight="4"
                       Opacity="0.55"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
