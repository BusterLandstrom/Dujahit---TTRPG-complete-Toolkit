<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vms="clr-namespace:Dujahit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:DataType="vms:JoinViewModel"
             x:Class="Dujahit.Views.JoinView"
             Background="{DynamicResource Background}"
             FontFamily="{DynamicResource MainFont}"
             Foreground="{DynamicResource Foreground}">
    <Grid>
        <Button Classes="ghost"
                Content="Back"
                Command="{Binding Back}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20" />
        <Border Classes="card"
                Width="460"
                Padding="36,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="20">
                <TextBlock Classes="header"
                           Text="Join a campaign"
                           HorizontalAlignment="Center" />
                <Border Classes="divider" />
                <StackPanel Spacing="8">
                    <TextBlock Classes="fieldLabel" Text="Host address" />
                    <TextBox AutomationProperties.Name="127.0.0.1" Text="{Binding CampaignAddress, Mode=TwoWay}"
                             Watermark="127.0.0.1"
                             Height="46"
                             FontSize="16"
                             HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Classes="fieldLabel" Text="Port" />
                    <TextBox AutomationProperties.Name="5555" Text="{Binding CampaignPort, Mode=TwoWay}"
                             Watermark="5555"
                             Height="46"
                             FontSize="16"
                             HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Classes="fieldLabel" Text="Join code" />
                    <TextBox AutomationProperties.Name="Ask the DM" Text="{Binding CampaignCode, Mode=TwoWay}"
                             Watermark="Ask the DM"
                             Height="46"
                             FontSize="16"
                             HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Classes="primary"
                        Content="Join"
                        Command="{Binding JoinGame}"
                        IsEnabled="{Binding !IsConnecting}"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0" />
                <TextBlock Text="Connecting..."
                           Foreground="{DynamicResource WidgetForeground}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsConnecting}" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{DynamicResource Danger}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !IsConnecting}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
