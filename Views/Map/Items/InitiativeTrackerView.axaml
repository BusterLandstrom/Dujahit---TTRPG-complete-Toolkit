<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dujahit.ViewModels"
             x:Class="Dujahit.Views.Map.Items.InitiativeTrackerView"
             x:DataType="vm:InitiativeTrackerViewModel"
             Background="Transparent"
             FontFamily="{DynamicResource MainFont}"
             Foreground="{DynamicResource Foreground}">

    <UserControl.Styles>
    </UserControl.Styles>

    <Border Classes="card" Padding="14,12">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="header" Text="Initiative"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TurnTimerLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Opacity="0.7"
                           IsVisible="{Binding CombatActive}"
                           ToolTip.Tip="Time on the current turn"/>
                <Border Grid.Column="2"
                        Classes="badge"
                        Background="{DynamicResource AccentColor}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding CombatActive}">
                    <TextBlock Text="{Binding Round, StringFormat='ROUND {0}'}"
                               Foreground="{DynamicResource Background}"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Combatants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CombatantViewModel">
                        <Button AutomationProperties.Name="{Binding Name}" Classes="combatantRow"
                                Classes.selected="{Binding IsSelected}"
                                Classes.active="{Binding IsActive}"
                                Margin="0,3,0,0"
                                Command="{Binding $parent[ItemsControl].((vm:InitiativeTrackerViewModel)DataContext).SelectCombatantCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <Border Grid.Column="0"
                                        Width="3"
                                        CornerRadius="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AccentColor}"
                                        IsVisible="{Binding IsActive}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Initiative}"
                                           Foreground="{DynamicResource AccentColor}"
                                           FontWeight="SemiBold"
                                           Width="28"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2"
                                        Width="26" Height="26"
                                        CornerRadius="13"
                                        ClipToBounds="True"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasPortrait}">
                                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource WidgetForeground}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Classes="fieldLabel"
                                               Text="{Binding EconomyLabel}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4"
                                           Classes="fieldLabel"
                                           Text="{Binding HpLabelForPlayers}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Classes="ghost"
                    Content="Roll all initiative"
                    Padding="12,6"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsVisible="{Binding IsDm}"
                    Command="{Binding RollAllInitiativeCommand}"/>

            <Button Grid.Row="3" Classes="accent"
                    Content="Start combat"
                    Padding="12,7"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsVisible="{Binding !CombatActive}"
                    Command="{Binding StartCombatCommand}"/>

            <Grid Grid.Row="4" ColumnDefinitions="*,*,*" Margin="0,14,0,0"
                  IsVisible="{Binding CombatActive}">
                <Button Grid.Column="0" Classes="ghost" Content="Prev" Padding="0,7" Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding PrevTurnCommand}"/>
                <Button Grid.Column="1" Classes="accent" Content="Next" Padding="0,7" Margin="3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NextTurnCommand}"/>
                <Button Grid.Column="2" Classes="ghost" Content="End" Padding="0,7" Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding EndCombatCommand}"/>
            </Grid>

            <Button Grid.Row="5" Classes="danger"
                    Content="Clear initiative"
                    Padding="12,6"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    IsVisible="{Binding IsDm}"
                    Command="{Binding ClearCombatCommand}"/>

        </Grid>
    </Border>
</UserControl>
