<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gv="clr-namespace:Dujahit.Models.Database"
             xmlns:vm="using:Dujahit.ViewModels"
             xmlns:v="using:Dujahit.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Dujahit.Views.NotesView"
             x:DataType="vm:NotesViewModel"
             Background="Transparent"
             FontFamily="{DynamicResource MainFont}"
             Foreground="{DynamicResource Foreground}">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:MarkdownEditorViewModel">
            <v:MarkdownEditorView/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource Divider}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Margin" Value="14,10,14,4"/>
        </Style>

        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TreeViewItem" x:DataType="vm:NotePageTreeNode">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource GlyphGray}"/>
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource GlyphGray}"/>
        </Style>

        <Style Selector="Button.add">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Widget}"/>
        </Style>

        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style Selector="Button.backlink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.backlink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="280,*">

        <Border Grid.Column="0"
                Background="{DynamicResource Widget}"
                CornerRadius="{DynamicResource CornerRadiusStandard}"
                Margin="16,16,8,16">
            <ScrollViewer>
                <StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0">
                        <TextBlock Grid.Column="0" Classes="section" Text="Private notes"/>
                        <Button Grid.Column="1"
                                Classes="add" Content="&#x2913;"
                                Margin="0,8,4,0"
                                AutomationProperties.Name="Import notes from a zip" ToolTip.Tip="Import notes from a zip">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Import a zip..." Command="{Binding ImportZipCommand}"/>
                                    <MenuItem Header="Save an example zip" Command="{Binding SaveImportExampleCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="add" Content="+"
                                Margin="0,8,10,0"
                                Command="{Binding AddRootPageCommand}" CommandParameter="private"
                                AutomationProperties.Name="New private page" ToolTip.Tip="New private page"/>
                    </Grid>
                    <TreeView ItemsSource="{Binding MyNotes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:NotePageTreeNode">
                                <Grid Classes="treeRow" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" Padding="4,2" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Classes="treeAdd" Content="+"
                                            Command="{Binding $parent[TreeView].((vm:NotesViewModel)DataContext).AddChildPageCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="New sub-page under this page" ToolTip.Tip="New sub-page under this page"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="section" Text="Shared notes"/>
                        <Button Grid.Column="1"
                                Classes="add" Content="+"
                                Margin="0,8,10,0"
                                Command="{Binding AddRootPageCommand}" CommandParameter="shared"
                                AutomationProperties.Name="New shared page (you can invite others to this)" ToolTip.Tip="New shared page (you can invite others to this)"/>
                    </Grid>
                    <TreeView ItemsSource="{Binding SharedNotes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:NotePageTreeNode">
                                <Grid Classes="treeRow" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" Padding="4,2" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Classes="treeAdd" Content="+"
                                            Command="{Binding $parent[TreeView].((vm:NotesViewModel)DataContext).AddChildPageCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="New sub-page under this page" ToolTip.Tip="New sub-page under this page"/>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Classes="section" Text="Quick notes"/>

                    <v:QuickNotesPanelView DataContext="{Binding QuickNotes}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="8,16,16,16">

            <Border Grid.Row="0"
                    Background="{DynamicResource Widget}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Padding="14"
                    Margin="0,0,0,8"
                    IsVisible="{Binding HasSelection}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding SelectedScopeLabel}"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   LetterSpacing="2"/>

                        <Panel HorizontalAlignment="Left">
                            <Button Classes="titleEdit"
                                    Content="{Binding SelectedTitle}"
                                    Command="{Binding BeginRenameCommand}"
                                    IsVisible="{Binding IsNotRenaming}"
                                    AutomationProperties.Name="Click to rename" ToolTip.Tip="Click to rename"/>
                            <TextBox x:Name="TitleBox" AutomationProperties.Name="Rename page" Classes="titleBox"
                                     Text="{Binding RenameDraft, Mode=TwoWay}"
                                     IsVisible="{Binding IsRenaming}"
                                     LostFocus="OnTitleLostFocus">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}"/>
                                    <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>

                        <Border Classes="row" Margin="0,6,0,0" Padding="10,6"
                                IsVisible="{Binding HasNoteCollision}"
                                BorderBrush="{DynamicResource Danger}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding NoteCollision}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource Danger}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Collaborators}" IsVisible="{Binding HasCollaborators}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CollaboratorPresence">
                                    <Border Background="{DynamicResource Background}"
                                            BorderBrush="{Binding ColorHex}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Ellipse Width="8" Height="8" Fill="{Binding ColorHex}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource WidgetForeground}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="toolbar" Content="{Binding PinButtonLabel}"
                                Command="{Binding ToggleDashboardPinCommand}"
                                AutomationProperties.Name="Pin this page to the campaign dashboard" ToolTip.Tip="Pin this page to the campaign dashboard"/>
                        <Button Classes="toolbar" Content="Share"
                                IsVisible="{Binding CanShareSelection}"
                                Command="{Binding ShareSelectedCommand}"/>
                        <Button Classes="toolbar" Content="Copy ref"
                                Command="{Binding CopyReferenceCommand}"
                                AutomationProperties.Name="Copy this note's reference tag to paste into another note" ToolTip.Tip="Copy this note's reference tag to paste into another note"/>
                        <Button Classes="toolbar" Content="Export"
                                AutomationProperties.Name="Export this page and its subpages" ToolTip.Tip="Export this page and its subpages">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Markdown (.md)" Command="{Binding ExportMarkdownCommand}"/>
                                    <MenuItem Header="PDF" Command="{Binding ExportPdfCommand}"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="toolbar"
                                Command="{Binding DeleteSelectedCommand}"
                                Foreground="{DynamicResource Danger}"
                                BorderBrush="{DynamicResource Danger}"
                                AutomationProperties.Name="Delete page (and all sub-pages)" ToolTip.Tip="Delete page (and all sub-pages)">
                            <PathIcon Data="{x:Static gv:GlobalVariables.IconClose}" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding Editor}"
                                IsVisible="{Binding HasSelection}"/>

                <Border IsVisible="{Binding !HasSelection}"
                        Background="{DynamicResource Widget}"
                        CornerRadius="{DynamicResource CornerRadiusStandard}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="No page selected"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Pick a page from the sidebar, or create a new one."
                                   Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource Widget}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Padding="14"
                    Margin="0,8,0,0"
                    MaxHeight="170"
                    IsVisible="{Binding HasBacklinks}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Linked from"
                               Foreground="{DynamicResource Muted}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               LetterSpacing="2"
                               Margin="0,0,0,6"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Backlinks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BacklinkEntry">
                                    <Button Classes="backlink"
                                            Command="{Binding OpenCommand}"
                                            AutomationProperties.Name="Go to this page" ToolTip.Tip="Go to this page">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding ScopeLabel}"
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountLabel}"
                                                       IsVisible="{Binding HasCount}"
                                                       Foreground="{DynamicResource Muted}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
