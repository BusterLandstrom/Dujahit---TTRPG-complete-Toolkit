<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dujahit.ViewModels"
             xmlns:db="clr-namespace:Dujahit.Models.Database"
             x:DataType="vm:TemplateEditorViewModel"
             x:Class="Dujahit.Views.TemplateEditorView"
             FontFamily="{DynamicResource MainFont}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Template editor" Classes="header"/>
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="choose" Content="Import statblock" Command="{Binding ToggleImportCommand}"/>
                <Button Classes="choose" Content="Export template" Command="{Binding ExportTemplateCommand}"
                        AutomationProperties.Name="Write this campaign's template out to a json file" ToolTip.Tip="Write this campaign's template out to a json file"/>
                <Button Classes="choose" Content="Reload" Command="{Binding ReloadCommand}"/>
                <Button Classes="choose" Content="Refresh catalog" Command="{Binding RefreshCatalogCommand}"
                        AutomationProperties.Name="Re-project the template's srd catalog into this campaign's tables, updating names, versions and the rest, leaving your custom entries alone" ToolTip.Tip="Re-project the template's srd catalog into this campaign's tables, updating names, versions and the rest, leaving your custom entries alone"/>
                <Button Classes="accent" Content="Validate" Command="{Binding ValidateCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="widget" Padding="12" Margin="0,0,0,12" IsVisible="{Binding ImportOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Paste a monster or npc statblock from a book, it lands in Monsters" Classes="sectionLabel" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Classes="primary" Content="Import" Command="{Binding ImportStatblockCommand}"/>
                    <TextBlock Text="Name on the first line, then the block as the book prints it."
                               Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox AutomationProperties.Name="Statblock text" Text="{Binding StatblockText}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="140" MaxHeight="260" FontFamily="Consolas, monospace" FontSize="13"
                         VerticalContentAlignment="Top"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="220,280,*">

            <Border Grid.Column="0" Classes="widget" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sections" Classes="sectionLabel" Margin="4,2,0,6"/>
                    <ListBox AutomationProperties.Name="Sections" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateCategoryRow">
                                <TextBlock Text="{Binding Display}" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Classes="widget" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Entries" Classes="sectionLabel" Margin="4,2,0,6"/>
                    <TextBox AutomationProperties.Name="Search id or name..." DockPanel.Dock="Top" Text="{Binding EntrySearch}" Watermark="Search id or name..." Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Classes="choose" Content="New" Command="{Binding NewEntryCommand}"/>
                        <Button Classes="danger" Content="Delete" Command="{Binding DeleteEntryCommand}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateEntryRow">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Display}" FontSize="13"/>
                                    <TextBlock Text="{Binding Sub}" Classes="muted" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="widget" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Entry JSON, edit and save" Classes="sectionLabel" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Classes="primary" Content="Save entry" Command="{Binding SaveEntryCommand}"/>
                        <TextBlock Text="Writes to this campaign's template, not the file on disk."
                                   Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox AutomationProperties.Name="Entry JSON" Text="{Binding EntryJson}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" FontFamily="Consolas, monospace" FontSize="13"
                             VerticalContentAlignment="Top"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Classes="widget" Padding="12" Margin="0,12,0,0" MaxHeight="180">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Validation" Classes="sectionLabel" Margin="0,0,0,6"/>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="db:TemplateIssue">
                                <Grid ColumnDefinitions="70,140,*" Margin="0,0,0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding Severity}" FontSize="12"
                                               Foreground="{DynamicResource Danger}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="fieldLabel"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Classes="body" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
