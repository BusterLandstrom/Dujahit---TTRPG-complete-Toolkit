<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS0067;CS0414</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishReadyToRun>true</PublishReadyToRun>
	  <AvaloniaUseCompiledXaml>true</AvaloniaUseCompiledXaml>
	  <ApplicationIcon>Assets\DujahitLogo.ico</ApplicationIcon>
	  <PackageIcon>DujahitLogo.ico</PackageIcon>
	  <Version>0.8.0</Version>
	  <AssemblyVersion>0.8.0.0</AssemblyVersion>
	  <FileVersion>0.8.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />

  </ItemGroup>

  <ItemGroup>
    <None Remove="Templates\dnd5e_template.json" />
    <None Remove="Templates\dnd5e_template_full.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Templates\*.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Avalonia" Version="11.0.10" />
	  <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
	  <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
	  <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
	  <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.0.10" />
	  <PackageReference Include="Avalonia.ReactiveUI" Version="11.0.10" />
	  <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
	  <PackageReference Include="Markdown.Avalonia.SyntaxHigh" Version="11.0.3" />
	  <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.3" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="LibVLCSharp" Version="3.8.2" />
	  <PackageReference Include="QuestPDF" Version="2024.12.3" />
	  <PackageReference Include="Docnet.Core" Version="2.6.0" />
	  <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
	  <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
	  <PackageReference Include="YDotNet" Version="0.6.0" />
	  <PackageReference Include="YDotNet.Native.Win32" Version="0.6.0" Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
	  <PackageReference Include="YDotNet.Native.Linux" Version="0.6.0" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
	  <PackageReference Include="YDotNet.Native.MacOS" Version="0.4.3" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\fonts\" />
  </ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

  <ItemGroup>
    <AvaloniaResource Update="Assets\fonts\lusitana\Lusitana-Regular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AvaloniaResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\CharacterSheetView.axaml.cs">
      <DependentUpon>CharacterSheetView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\DujahitLogo.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Models\Database\DatabaseRequests\CreateDB.dbi">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>