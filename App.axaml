<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dujahit.App"
             xmlns:local="using:Dujahit"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

	<Application.Resources>

		<SolidColorBrush x:Key="Background" Color="#0F0F1A" />

		<SolidColorBrush x:Key="Foreground" Color="#F5F0E1" />

		<SolidColorBrush x:Key="Widget" Color="#1A1A2A" />

		<SolidColorBrush x:Key="WidgetForeground" Color="#ECEAF0"/>

		<SolidColorBrush x:Key="AccentColor" Color="#FFD700" />

		<SolidColorBrush x:Key="AccentHover" Color="#BFA050" />

		<SolidColorBrush x:Key="Divider" Color="#3A3A4D" />

		<SolidColorBrush x:Key="Muted" Color="#9A96A8" />

		<SolidColorBrush x:Key="Danger" Color="#BB4444" />

		<SolidColorBrush x:Key="BackdropGlyph" Color="#00000000" />
		<SolidColorBrush x:Key="BackdropBrush" Color="#00000000" />
		<x:String x:Key="ThemeEasterEgg">-</x:String>
		<x:Boolean x:Key="ThemeEasterEggVisible">False</x:Boolean>

		<CornerRadius x:Key="CornerRadiusStandard">8</CornerRadius>
		<CornerRadius x:Key="CornerRadiusLarge">20</CornerRadius>

		<x:Double x:Key="FontSizeHeader">20</x:Double>
		<x:Double x:Key="FontSizeNormal">14</x:Double>
		<x:Double x:Key="FontSizeSmall">12</x:Double>

		<FontFamily x:Key="MainFont">avares://Dujahit/Assets/fonts/lusitana/Lusitana-Regular.ttf#Lusitana</FontFamily>

		<Color x:Key="SystemAccentColor">#FFD700</Color>
		<Color x:Key="SystemAccentColorLight1">#FFDF33</Color>
		<Color x:Key="SystemAccentColorLight2">#FFE766</Color>
		<Color x:Key="SystemAccentColorLight3">#FFEF99</Color>
		<Color x:Key="SystemAccentColorDark1">#BFA050</Color>
		<Color x:Key="SystemAccentColorDark2">#8F7838</Color>
		<Color x:Key="SystemAccentColorDark3">#5F5025</Color>
	</Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
        </Style>

		<Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Widget}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
            <Setter Property="Padding" Value="36,32" />
            <Setter Property="BoxShadow" Value="0 12 48 -12 #000000" />
        </Style>

        <Style Selector="Border.widget">
            <Setter Property="Background" Value="{DynamicResource Widget}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
        </Style>

        <Style Selector="Button.widgetBar">
            <Setter Property="Background" Value="{DynamicResource Widget}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.widgetBar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}" />
        </Style>

        <Style Selector="TextBlock.widgetTitle">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
        </Style>

        <Style Selector="Border.dividerV">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
        </Style>

        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeHeader}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        </Style>

        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource Background}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="Button.choose">
            <Setter Property="Background" Value="{DynamicResource Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="Padding" Value="18,8" />
        </Style>

        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>

        <Style Selector="Button.sound">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button.sound:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>

        <Style Selector="Button.star">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.star:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

        <Style Selector="Button.del">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.del:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>

        <Style Selector="Button.combatantRow">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.combatantRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.combatantRow.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.combatantRow.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource Widget}" />
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}" />
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentHover}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        </Style>


        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}" />
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="TextBlock.sectionLabel">
          <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
          <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
          <Setter Property="LetterSpacing" Value="2"/>
        </Style>

        <Style Selector="Border.panel">
          <Setter Property="Background" Value="{DynamicResource Widget}"/>
          <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}"/>
          <Setter Property="Padding" Value="22,20"/>
          <Setter Property="BoxShadow" Value="0 12 48 -12 #000000"/>
        </Style>

        <Style Selector="Border.row">
          <Setter Property="Background" Value="{DynamicResource Background}"/>
          <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
          <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style Selector="Border.sticky">
          <Setter Property="Background" Value="{DynamicResource Background}"/>
          <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
          <Setter Property="Padding" Value="16,14"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
          <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.close">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource Divider}"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="6,0"/>
          <Setter Property="FontSize" Value="{DynamicResource FontSizeHeader}"/>
        </Style>

        <Style Selector="Button.close:pointerover /template/ ContentPresenter">
          <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        
        <Style Selector="Border.maptile">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.maptile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>

        <Style Selector="TextBlock.tileName">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="Border.toolPanel">
            <Setter Property="Background" Value="{DynamicResource Widget}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BoxShadow" Value="0 12 48 -12 #000000"/>
        </Style>

        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>
        <Style Selector="Button.tool.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>
        <Style Selector="Button.tool.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Widget}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusStandard}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ContextMenu MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style Selector="ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem:pressed /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem.danger">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem.danger:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
        </Style>
        <Style Selector="ContextMenu MenuItem.danger:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}"/>
        </Style>
        <Style Selector="ContextMenu Separator">
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <Style Selector="CheckBox.spellPrep">
            <Setter Property="Transitions" Value="{x:Null}"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="CheckBox.spellPrep /template/ Border#NormalRectangle">
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="CheckBox.spellPrep /template/ Path#CheckGlyph">
            <Setter Property="Transitions" Value="{x:Null}"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>

        <Style Selector="Border.skillRow">
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.skillRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Background}"/>
        </Style>

        <Style Selector="Button.titleEdit">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.titleEdit /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.titleEdit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
        </Style>
        <Style Selector="Button.titleEdit:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="ShowButtonSpinner" Value="False"/>
        </Style>

        <Style Selector="TextBox.titleBox">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="TextBox.titleBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.titleBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.titleBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Grid.treeRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Grid.treeRow Button.treeAdd">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.treeRow:pointerover Button.treeAdd">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Button.treeAdd">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WidgetForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="6,0,2,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.treeAdd /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.treeAdd:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>
        <Style Selector="Button.treeAdd:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        </Style>

    </Application.Styles>

</Application>